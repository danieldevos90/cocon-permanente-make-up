# Dashboard
DASHBOARD_PASSWORD=

# API JWT (HS256; defaults to CRON_SECRET if unset)
API_JWT_SECRET=
API_CLIENT_ID=api
API_CLIENT_SECRET=

# Active tenant (maps to whatsapp-automations/config/clients/{CLIENT_ID}.json)
CLIENT_ID=cocon

# Platform branding (optional overrides; defaults from client JSON + platform.json)
NEXT_PUBLIC_PLATFORM_NAME=
NEXT_PUBLIC_CLIENT_NAME=
NEXT_PUBLIC_CLIENT_DISPLAY_PHONE=
NEXT_PUBLIC_CLIENT_ONBOARD_CONTACT=

# Mailchimp (tenant-specific — Cocon)
API_KEY_MAILCHIMP=
MAILCHIMP_LIST_ID=

# Salonized (tenant-specific)
SALONIZED_ICAL_URL=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# AFA - Message Platform (Meta App ID 823081517310848)
# ----------------------------------------------------------------------------
META_APP_ID=823081517310848
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=971625582419184

NEXT_PUBLIC_META_APP_ID=823081517310848
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=971625582419184
NEXT_PUBLIC_WHATSAPP_ONBOARD_GATE=
WHATSAPP_ONBOARD_ACCESS_TOKEN=

# WhatsApp Cloud API (tenant WABA — set after onboarding or from env)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# true = log only (App Review demos OK with pending templates)
# false = live sends (requires approved templates + connected phone)
WHATSAPP_DRY_RUN=true

# Tenant URL overrides (optional — defaults from config/clients/{CLIENT_ID}.json)
BOOKING_URL=
AFTERCARE_BROWS_URL=
AFTERCARE_EYELINER_URL=
AFTERCARE_LIPS_URL=
WHATSAPP_DISPLAY_PHONE=
