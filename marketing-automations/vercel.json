{
  "version": 2,
  "framework": "nextjs",
  "rewrites": [
    { "source": "/health", "destination": "/api/overview?format=html" },
    { "source": "/overzicht", "destination": "/api/overview?format=html" }
  ],
  "functions": {
    "app/api/cron-sync/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-sync",
      "schedule": "0 10,13,16,20 * * *"
    }
  ]
}
