# ----------------------------------------------------------------------------
# Meta WhatsApp Cloud API — vereist voor live verzending
# ----------------------------------------------------------------------------
# Instructies om deze waardes op te halen staan in README.md (sectie Setup).
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v21.0

# Webhook verificatie (Meta App Dashboard → Webhooks)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# ----------------------------------------------------------------------------
# Operationele flags
# ----------------------------------------------------------------------------
# DRY_RUN=true betekent: geen echte API call naar Meta, alleen loggen.
# Houd dit op true totdat templates zijn goedgekeurd en opt-in flow live is.
WHATSAPP_DRY_RUN=true

# Default landcode voor telefoonnummers zonder + prefix (NL = 31)
WHATSAPP_DEFAULT_COUNTRY_CODE=31

# Fallback naar e-mail als WhatsApp verzending faalt (true/false)
WHATSAPP_FALLBACK_TO_EMAIL=true

# ----------------------------------------------------------------------------
# Logging / delivery status — Upstash Redis (gedeeld met marketing-automations)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# Salonized iCal — gedeeld met marketing-automations
# ----------------------------------------------------------------------------
SALONIZED_ICAL_URL=

# ----------------------------------------------------------------------------
# Mailchimp koppeling — voor opt-in lookup + fallback email
# ----------------------------------------------------------------------------
API_KEY_MAILCHIMP=
MAILCHIMP_LIST_ID=

# ----------------------------------------------------------------------------
# URLs in WhatsApp templates
# ----------------------------------------------------------------------------
BOOKING_URL=https://www.coconpermanentemakeup.nl/afspraak-maken
AFTERCARE_BROWS_URL=https://www.coconpermanentemakeup.nl/kennisbank/nazorg-permanente-make-up-wenkbrauwen/
AFTERCARE_EYELINER_URL=https://www.coconpermanentemakeup.nl/kennisbank/nazorg-permanente-make-up-eyeliner/
AFTERCARE_LIPS_URL=https://www.coconpermanentemakeup.nl/kennisbank/nazorg-permanente-make-up-lippen/

# ----------------------------------------------------------------------------
# Beveiliging
# ----------------------------------------------------------------------------
# Token voor handmatige sync trigger / API call vanuit marketing-automations
WHATSAPP_TRIGGER_TOKEN=
